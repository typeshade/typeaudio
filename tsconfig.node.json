{
  // The files that run on a host with Node's API: the build and browser scripts, the runners of
  // the experiments, the test that reads a shader module's source, and the Vitest configuration.
  // Everything else is `tsconfig.json`'s.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "experiments/**/run.ts",
    "experiments/**/node.ts",
    "test/browser/run.ts",
    "test/browser-options.test.ts",
    "test/fft.test.ts",
    "vitest.config.ts",
    "website/vite.config.ts",
    "website/check-browser.ts"
  ],
  "exclude": ["**/*.shade.ts"]
}
