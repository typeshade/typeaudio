{
  "name": "typeaudio",
  "version": "0.0.0",
  "private": true,
  "description": "A GPU audio engine written in TypeScript, on TypeShade.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/typeshade/typeaudio"
  },
  "scripts": {
    "prepare": "bun --bun tshc sync",
    "check": "tshc sync --check && tshc check src experiments && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:gpu": "bun test/browser/run.ts",
    "exp:01": "bun experiments/01-round-trip/run.ts",
    "exp:02": "bun experiments/02-worklet/run.ts",
    "exp:03": "bun experiments/03-fft/run.ts",
    "exp:04": "bun experiments/04-additive/run.ts",
    "exp:05": "bun experiments/05-convolution/run.ts",
    "exp:06": "bun experiments/06-granular/run.ts",
    "exp:07": "bun experiments/07-sound-match/run.ts",
    "dev:website": "vite --config website/vite.config.ts",
    "build:website": "vite build --config website/vite.config.ts && bun scripts/site-docs.ts",
    "check:website": "tsc -p website/tsconfig.json",
    "test:website": "bun website/check-browser.ts",
    "feedback": "bun scripts/feedback.ts",
    "test:feedback": "vitest run test/graph-feedback.test.ts"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "marked": "17.0.1",
    "playwright-core": "1.64.1",
    "typescript": "5.6.3",
    "typeshade": "https://github.com/typeshade/typeshade/archive/87af4eb0d9d15f02b66b8341b72cab0944290472.tar.gz",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "exports": {
    ".": "./src/index.ts",
    "./graph": "./src/graph/index.ts",
    "./graph/compiler": "./src/graph/compiler/index.ts",
    "./graph/runtime": "./src/graph/runtime.ts",
    "./feedback": "./src/feedback/index.ts",
    "./spatial": "./src/spatial/index.ts"
  }
}
